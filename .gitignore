# ==========================================================
#  私有 / 敏感 —— 绝对不要提交
# ==========================================================

# 命令行版的真实配置：里面是账号、学号、明文密码
gdep-grab/config.json

# 扩展打包用的 RSA 私钥。它决定了扩展 ID，泄露 = 别人能签同名扩展
*.pem
dist/

# 运行日志（可能含账号名 / 学号）
**/logs/
*.log

# ==========================================================
#  构建产物
# ==========================================================

*.crx
chrome-extension/dist/

# ==========================================================
#  运行时 / 缓存
# ==========================================================

node_modules/
__pycache__/
*.pyc

# 测试脚本写出的日志（tools/run-node.py 会生成）
chrome-extension/tools/_test.txt
chrome-extension/tools/_verify.txt
chrome-extension/tools/_syntax.txt
chrome-extension/tools/_dist.txt

# ==========================================================
#  编辑器 / 操作系统
# ==========================================================

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.swp

.DS_Store
Thumbs.db
desktop.ini
